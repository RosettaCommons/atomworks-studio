+//! Structured embedder queries and edits using the upstream scene/renderer.
+use super::*;
+use lin_alg::f32::Vec3;
+use patinae_mol::{Atom, AtomIndex, CoordSet, Element, ObjectMolecule};
+use patinae_scene::{
+    resolve_measurement_entity_value, AtomAnchor, LabelEntity, LabelObject, MeasurementEntry,
+    MeasurementObject, MeasurementResolveOptions, MoleculeObject,
+};
+use serde::Deserialize;
+#[derive(Serialize, Debug, PartialEq, Eq)]
+struct ObjectAtomIndices {
+    object_name: String,
+    atom_indices: Vec<usize>,
+}
+
+/// Stable atom identity plus the two orderings consumers commonly need.
+///
+/// `document_index` is the zero-based atom order across molecule objects in
+/// registry/document order. `atom_index` is Patinae's zero-based index within
+/// `object_name`, suitable for native `index` selections.
+#[derive(Serialize, Debug, PartialEq, Eq)]
+struct AtomIdentity {
+    document_index: usize,
+    object_name: String,
+    atom_index: usize,
+    source_atom_id: i32,
+    atom_name: String,
+    element: String,
+    chain_id: String,
+    residue_name: String,
+    residue_number: i32,
+    insertion_code: String,
+    alternate_location: String,
+}
+
+fn atom_identity_map(session: &Session) -> Vec<AtomIdentity> {
+    let mut document_index = 0;
+    let mut identities = Vec::new();
+    for object_name in session
+        .registry
+        .names()
+        .filter(|name| !name.starts_with("_studio_"))
+    {
+        let Some(object) = session.registry.get_molecule(object_name) else {
+            continue;
+        };
+        for (atom_index, atom) in object.molecule().atoms().enumerate() {
+            identities.push(AtomIdentity {
+                document_index,
+                object_name: object_name.to_string(),
+                atom_index,
+                source_atom_id: atom.id,
+                atom_name: atom.name.to_string(),
+                element: atom.element.symbol().to_string(),
+                chain_id: atom.residue.key.chain.clone(),
+                residue_name: atom.residue.resn.clone(),
+                residue_number: atom.residue.key.resv,
+                insertion_code: atom.residue.key.inscode.to_string(),
+                alternate_location: atom.alt.to_string(),
+            });
+            document_index += 1;
+        }
+    }
+    identities
+}
+
+#[derive(Serialize, Debug, PartialEq, Eq)]
+struct SelectionEvaluation {
+    expression: String,
+    atom_count: usize,
+    objects: Vec<ObjectAtomIndices>,
+}
+
+#[derive(Serialize)]
+struct CommandMetadata {
+    name: String,
+    aliases: Vec<String>,
+    description: String,
+    usage: String,
+    arguments: String,
+    help: String,
+    web_safe: bool,
+    unavailable_reason: Option<&'static str>,
+}
+
+#[derive(Serialize, Debug, PartialEq)]
+struct MeasurementInfo {
+    name: String,
+    enabled: bool,
+    measurements: Vec<MeasurementEntryInfo>,
+}
+
+#[derive(Serialize, Debug, PartialEq)]
+struct MeasurementEntryInfo {
+    kind: &'static str,
+    value: f64,
+    label: String,
+}
+
+#[derive(Deserialize, Debug)]
+#[serde(rename_all = "lowercase")]
+enum MeasurementRequestKind {
+    Distance,
+    Angle,
+    Dihedral,
+}
+
+#[derive(Deserialize, Debug)]
+struct MeasurementRequest {
+    kind: MeasurementRequestKind,
+    name: String,
+    #[serde(default)]
+    selections: Option<Vec<String>>,
+    #[serde(default)]
+    points: Option<Vec<[f32; 3]>>,
+    #[serde(default)]
+    color: Option<[f32; 4]>,
+    #[serde(default)]
+    label: Option<String>,
+}
+
+fn evaluate_selection(
+    session: &mut Session,
+    expression: &str,
+) -> Result<SelectionEvaluation, String> {
+    let mut needs_redraw = false;
+    let adapter = SessionAdapter {
+        session,
+        render_context: None,
+        default_size: (1, 1),
+        needs_redraw: &mut needs_redraw,
+    };
+    let (_, results) = patinae_cmd::commands::selecting::select_with_context(&adapter, expression)
+        .map_err(|e| format!("Selection error: {e}"))?;
+    let objects: Vec<_> = results
+        .into_iter()
+        .filter(|(name, _)| !name.starts_with("_studio_"))
+        .filter_map(|(object_name, result)| {
+            let atom_indices: Vec<usize> = result.raw_indices().collect();
+            (!atom_indices.is_empty()).then_some(ObjectAtomIndices {
+                object_name,
+                atom_indices,
+            })
+        })
+        .collect();
+    Ok(SelectionEvaluation {
+        expression: expression.to_string(),
+        atom_count: objects.iter().map(|object| object.atom_indices.len()).sum(),
+        objects,
+    })
+}
+
+fn command_is_web_safe(name: &str) -> (bool, Option<&'static str>) {
+    match name {
+        "load" | "load_traj" | "fetch" => (
+            false,
+            Some("use PatinaeViewer.loadData/loadUrl in the browser"),
+        ),
+        "save" | "cd" | "pwd" | "ls" | "run" => (false, Some("requires local filesystem access")),
+        "png" => (false, Some("browser capture renderer is not implemented")),
+        "quit" => (
+            false,
+            Some("application lifecycle command is not available on web"),
+        ),
+        _ => (true, None),
+    }
+}
+
+fn command_catalog(executor: &CommandExecutor) -> Vec<CommandMetadata> {
+    let registry = executor.registry();
+    let mut names: Vec<&str> = registry.names().collect();
+    names.sort_unstable();
+    names
+        .into_iter()
+        .filter_map(|name| registry.get(name))
+        .map(|command| {
+            let (web_safe, unavailable_reason) = command_is_web_safe(command.name());
+            CommandMetadata {
+                name: command.name().to_string(),
+                aliases: command
+                    .aliases()
+                    .iter()
+                    .map(|alias| (*alias).to_string())
+                    .collect(),
+                description: command.description().to_string(),
+                usage: command.usage().to_string(),
+                arguments: command.arguments().to_string(),
+                help: command.help().to_string(),
+                web_safe,
+                unavailable_reason,
+            }
+        })
+        .collect()
+}
+
+#[wasm_bindgen]
+impl WebViewer {
+    #[wasm_bindgen(js_name = getAtomIdentityMap)]
+    pub fn get_atom_identity_map(&self) -> JsValue {
+        serde_wasm_bindgen::to_value(&atom_identity_map(&self.state.borrow().session))
+            .unwrap_or(JsValue::NULL)
+    }
+
+    /// Evaluate an expression with object and named-selection context.
+    ///
+    /// Returns `{ expression, atom_count, objects: [{ object_name,
+    /// atom_indices }] }`, where atom indices are zero-based per object.
+    #[wasm_bindgen(js_name = evaluateSelection)]
+    pub fn evaluate_selection(&mut self, expression: &str) -> Result<JsValue, JsValue> {
+        let evaluation = evaluate_selection(&mut self.state.borrow_mut().session, expression)
+            .map_err(|e| JsValue::from_str(&e))?;
+        serde_wasm_bindgen::to_value(&evaluation)
+            .map_err(|e| JsValue::from_str(&format!("Serialization error: {e}")))
+    }
+
+    #[wasm_bindgen(js_name = getCommandCatalog)]
+    pub fn studio_command_catalog(&self) -> Result<JsValue, JsValue> {
+        serde_wasm_bindgen::to_value(&command_catalog(&self.state.borrow().executor))
+            .map_err(js_error)
+    }
+    #[wasm_bindgen(js_name = getMeasurementList)]
+    pub fn studio_measurements(&self) -> Result<JsValue, JsValue> {
+        serde_wasm_bindgen::to_value(&measurement_infos(&self.state.borrow().session))
+            .map_err(js_error)
+    }
+    #[wasm_bindgen(js_name = addMeasurements)]
+    pub fn studio_add_measurements(&mut self, requests: JsValue) -> Result<JsValue, JsValue> {
+        let mut state = self.state.borrow_mut();
+        let requests: Vec<MeasurementRequest> =
+            serde_wasm_bindgen::from_value(requests).map_err(js_error)?;
+        // Resolve and validate the whole batch before changing the scene.
+        let resolved = requests
+            .into_iter()
+            .map(|r| prepare_measurement(&mut state.session, r))
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(js_error)?;
+        let mut names = Vec::new();
+        for (name, measurement, source, label) in resolved {
+            remove_measurement(&mut state.session, &name);
+            if let Some(source) = source {
+                state.session.registry.add(source);
+            }
+            state.session.registry.add(measurement);
+            if let Some(label) = label {
+                state.session.registry.add(label);
+            }
+            names.push(name);
+        }
+        state.needs_redraw = true;
+        let added: Vec<_> = measurement_infos(&state.session)
+            .into_iter()
+            .filter(|m| names.contains(&m.name))
+            .collect();
+        serde_wasm_bindgen::to_value(&added).map_err(js_error)
+    }
+    #[wasm_bindgen(js_name = removeMeasurements)]
+    pub fn studio_remove_measurements(&mut self, names: JsValue) -> Result<usize, JsValue> {
+        let mut state = self.state.borrow_mut();
+        let names: Vec<String> = serde_wasm_bindgen::from_value(names).map_err(js_error)?;
+        let count = names
+            .iter()
+            .filter(|name| remove_measurement(&mut state.session, name))
+            .count();
+        state.needs_redraw |= count > 0;
+        Ok(count)
+    }
+}
+fn js_error(error: impl std::fmt::Display) -> JsValue {
+    JsValue::from_str(&error.to_string())
+}
+
+fn remove_measurement(session: &mut Session, name: &str) -> bool {
+    if session.registry.get_measurement(name).is_none() {
+        return false;
+    }
+    session.registry.remove(name);
+    session.registry.remove(&format!("_studio_points_{name}"));
+    session.registry.remove(&format!("_studio_label_{name}"));
+    true
+}
+
+type PreparedMeasurement = (
+    String,
+    MeasurementObject,
+    Option<MoleculeObject>,
+    Option<LabelObject>,
+);
+fn prepare_measurement(
+    session: &mut Session,
+    request: MeasurementRequest,
+) -> Result<PreparedMeasurement, String> {
+    if request.name.trim().is_empty() || request.name.starts_with("_studio_") {
+        return Err("Measurement name is empty or reserved".into());
+    }
+    if session.registry.get(&request.name).is_some()
+        && session.registry.get_measurement(&request.name).is_none()
+    {
+        return Err("Measurement name is already used by another object".into());
+    }
+    let kind = match request.kind {
+        MeasurementRequestKind::Distance => MeasurementKind::Distance,
+        MeasurementRequestKind::Angle => MeasurementKind::Angle,
+        MeasurementRequestKind::Dihedral => MeasurementKind::Dihedral,
+    };
+    let source_name = format!("_studio_points_{}", request.name);
+    let mut source = None;
+    let anchors = match (request.selections, request.points) {
+        (Some(selections), None) if selections.len() == kind.anchor_count() => {
+            let mut anchors = Vec::new();
+            for expression in selections {
+                let mut redraw = false;
+                let adapter = SessionAdapter {
+                    session,
+                    render_context: None,
+                    default_size: (1, 1),
+                    needs_redraw: &mut redraw,
+                };
+                let selected =
+                    patinae_cmd::commands::selecting::evaluate_atom_anchors(&adapter, &expression)
+                        .map_err(|e| e.to_string())?;
+                let selected: Vec<_> = selected
+                    .into_iter()
+                    .filter(|anchor| !anchor.object_name.starts_with("_studio_"))
+                    .collect();
+                if selected.len() != 1 {
+                    return Err("Each measurement operand must select exactly one atom".into());
+                }
+                anchors.push(selected[0].clone());
+            }
+            anchors
+        }
+        (None, Some(points))
+            if points.len() == kind.anchor_count()
+                && points.iter().flatten().all(|x| x.is_finite()) =>
+        {
+            let mut molecule = ObjectMolecule::new(&source_name);
+            for _ in &points {
+                molecule.add_atom(Atom::new("X", Element::Carbon));
+            }
+            molecule.add_coord_set(CoordSet::from_vec3(
+                &points
+                    .iter()
+                    .map(|p| Vec3::new(p[0], p[1], p[2]))
+                    .collect::<Vec<_>>(),
+            ));
+            let mut object = MoleculeObject::with_name(molecule, &source_name);
+            object.disable();
+            source = Some(object);
+            (0..points.len())
+                .map(|i| AtomAnchor::new(&source_name, AtomIndex(i as u32)))
+                .collect()
+        }
+        _ => {
+            return Err(format!(
+                "Provide exactly {} selections or finite points",
+                kind.anchor_count()
+            ))
+        }
+    };
+    let mut measurement = MeasurementObject::new(&request.name, kind);
+    measurement
+        .add_entry(MeasurementEntry::new(anchors.clone()))
+        .map_err(|e| e.to_string())?;
+    if let Some(color) = request.color {
+        if !color
+            .iter()
+            .all(|c| c.is_finite() && (0.0..=1.0).contains(c))
+        {
+            return Err("Invalid measurement color".into());
+        }
+        let color_name = format!("studio_{}", request.name);
+        let index = session.named_palette.register(
+            &color_name,
+            patinae_color::Color::new(color[0], color[1], color[2]),
+        );
+        measurement.set_color(patinae_color::ColorIndex::Named(index));
+    }
+    let hide_label = request.label.is_some();
+    let label = request.label.filter(|text| !text.is_empty()).map(|text| {
+        LabelObject::with_entities(
+            format!("_studio_label_{}", request.name),
+            vec![LabelEntity::new(anchors[0].clone(), text)],
+        )
+    });
+    if hide_label {
+        measurement.presentation_mut().set_label_visible(false);
+    }
+    Ok((request.name, measurement, source, label))
+}
+
+fn measurement_infos(session: &Session) -> Vec<MeasurementInfo> {
+    let options = MeasurementResolveOptions::from_settings(&session.settings.measurement);
+    session
+        .registry
+        .names()
+        .filter_map(|name| {
+            let object = session.registry.get_measurement(name)?;
+            let measurements = object
+                .entries()
+                .iter()
+                .filter_map(|entry| {
+                    let value = resolve_measurement_entity_value(
+                        &session.registry,
+                        object.kind(),
+                        entry,
+                        options,
+                    )?;
+                    Some(MeasurementEntryInfo {
+                        kind: super::measurement_kind_name(object.kind()),
+                        value,
+                        label: session
+                            .registry
+                            .get_label(&format!("_studio_label_{name}"))
+                            .and_then(|label| label.entities().first())
+                            .map(|label| label.text().to_owned())
+                            .unwrap_or_else(|| {
+                                if object.kind() == MeasurementKind::Distance {
+                                    format!("{value:.2} Å")
+                                } else {
+                                    format!("{value:.2}°")
+                                }
+                            }),
+                    })
+                })
+                .collect();
+            Some(MeasurementInfo {
+                name: name.to_owned(),
+                enabled: object.is_enabled(),
+                measurements,
+            })
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn insert(session: &mut Session, request: MeasurementRequest) {
+        let (_, measurement, source, label) = prepare_measurement(session, request).unwrap();
+        if let Some(source) = source {
+            session.registry.add(source);
+        }
+        session.registry.add(measurement);
+        if let Some(label) = label {
+            session.registry.add(label);
+        }
+    }
+
+    #[test]
+    fn point_markers_use_native_measurements_without_entering_document_identity_map() {
+        let mut session = Session::new();
+        insert(
+            &mut session,
+            MeasurementRequest {
+                kind: MeasurementRequestKind::Distance,
+                name: "centroid".into(),
+                selections: None,
+                points: Some(vec![[0., 0., 0.], [3., 4., 0.]]),
+                color: Some([0., 1., 1., 1.]),
+                label: Some("Center".into()),
+            },
+        );
+        let measurements = measurement_infos(&session);
+        assert_eq!(measurements.len(), 1);
+        assert_eq!(measurements[0].measurements[0].value, 5.);
+        assert!(atom_identity_map(&session).is_empty());
+        assert_eq!(
+            evaluate_selection(&mut session, "all").unwrap().atom_count,
+            0
+        );
+        assert!(session
+            .registry
+            .get_label("_studio_label_centroid")
+            .is_some());
+        assert!(remove_measurement(&mut session, "centroid"));
+        assert_eq!(session.registry.names().count(), 0);
+    }
+
+    #[test]
+    fn named_selections_and_dynamic_measurements_share_upstream_atom_identity() {
+        let mut session = Session::new();
+        let mut molecule = ObjectMolecule::new("model");
+        for name in ["N", "CA", "C", "O"] {
+            molecule.add_atom(Atom::new(name, Element::Carbon));
+        }
+        molecule.add_coord_set(CoordSet::from_vec3(&[
+            Vec3::new(1., 0., 0.),
+            Vec3::new(0., 0., 0.),
+            Vec3::new(0., 1., 0.),
+            Vec3::new(0., 1., 1.),
+        ]));
+        session
+            .registry
+            .add(MoleculeObject::with_name(molecule, "model"));
+        session.selections.define("alpha", "name CA");
+        let selected = evaluate_selection(&mut session, "alpha or name C").unwrap();
+        assert_eq!(selected.objects[0].atom_indices, vec![1, 2]);
+        let cases = [
+            (
+                MeasurementRequestKind::Distance,
+                vec!["name N", "alpha"],
+                1.,
+            ),
+            (
+                MeasurementRequestKind::Angle,
+                vec!["name N", "alpha", "name C"],
+                90.,
+            ),
+            (
+                MeasurementRequestKind::Dihedral,
+                vec!["name N", "alpha", "name C", "name O"],
+                90.,
+            ),
+        ];
+        for (i, (kind, selections, expected)) in cases.into_iter().enumerate() {
+            let name = format!("m{i}");
+            insert(
+                &mut session,
+                MeasurementRequest {
+                    kind,
+                    name: name.clone(),
+                    selections: Some(selections.into_iter().map(str::to_owned).collect()),
+                    points: None,
+                    color: None,
+                    label: None,
+                },
+            );
+            let measurements = measurement_infos(&session);
+            let value = measurements
+                .iter()
+                .find(|m| m.name == name)
+                .unwrap()
+                .measurements[0]
+                .value;
+            assert!((value.abs() - expected).abs() < 1e-5, "{name}: {value}");
+        }
+        assert_eq!(atom_identity_map(&session).len(), 4);
+    }
+}
