+
+interface MeasurementRequestBase {
+  name: string;
+  color?: MeasurementColor;
+  /** Overrides the generated numeric label, including with an empty string. */
+  label?: string;
+}
+
+type MeasurementSource<S extends readonly string[], P extends readonly MeasurementPoint[]> =
+  | { selections: S; points?: never }
+  | { points: P; selections?: never };
+
+export type DistanceMeasurement = MeasurementRequestBase
+  & { kind: "distance" }
+  & MeasurementSource<
+    [string, string],
+    [MeasurementPoint, MeasurementPoint]
+  >;
+
+export type AngleMeasurement = MeasurementRequestBase
+  & { kind: "angle" }
+  & MeasurementSource<
+    [string, string, string],
+    [MeasurementPoint, MeasurementPoint, MeasurementPoint]
+  >;
+
+export type DihedralMeasurement = MeasurementRequestBase
+  & { kind: "dihedral" }
+  & MeasurementSource<
+    [string, string, string, string],
+    [MeasurementPoint, MeasurementPoint, MeasurementPoint, MeasurementPoint]
+  >;
+
+/**
+ * Exactly one of `selections` or `points` must be supplied. Selection entries
+ * resolve to the first matching atom in scene/render order.
+ */
+export type MeasurementRequest =
+  | DistanceMeasurement
+  | AngleMeasurement
+  | DihedralMeasurement;
